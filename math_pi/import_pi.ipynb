    "import csv\n",
    "\n",
    "with open(\"first_100000000_digits_of_pi.csv\", mode=\"r\", newline=\"\") as file:\n",
    "  reader = csv.reader(file)\n",
    "  next(reader)  # Skips the header row\n",
    "  data = [(int(row[0]), int(row[1])) for row in reader]\n",
    "print(data[:10])"
